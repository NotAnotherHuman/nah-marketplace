{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PLUGIN_ROOT/hooks/guard-git.sh" },
          { "type": "command", "command": "$CLAUDE_PLUGIN_ROOT/hooks/guard-boundary.sh" }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PLUGIN_ROOT/hooks/guard-boundary.sh" }
        ]
      }
    ]
  }
}
